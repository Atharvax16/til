   "source": [
    "# %% [17] The compression trade-off curve -----------------------------------\n",
    "fig, ax = plt.subplots(1, 2, figsize=(11, 3.8))\n",
    "for pname, g in summary.groupby(\"policy\"):\n",
    "    ax[0].plot(g.k, g.auroc, \"o-\", ms=3.5, label=pname)\n",
    "    ax[1].plot(D_IN / (2 * g.k), g.auroc, \"o-\", ms=3.5, label=pname)\n",
    "for a in ax:\n",
    "    a.axhline(dense_auc, ls=\"--\", c=\"k\", lw=1, label=\"dense baseline (512 numbers)\")\n",
    "    a.axhline(sparse_auc, ls=\":\", c=\"gray\", lw=1, label=\"full sparse code\")\n",
    "    a.set_ylabel(\"QA AUROC (mean over questions)\")\n",
    "ax[0].set_xscale(\"log\", base=2); ax[0].set_xlabel(\"k = features retained in memory\")\n",
    "ax[1].set_xscale(\"log\", base=2); ax[1].set_xlabel(\"compression factor vs dense (x)\")\n",
    "ax[0].legend(fontsize=7); ax[0].set_title(\"(a) accuracy vs memory size\", fontsize=9)\n",
    "ax[1].set_title(\"(b) accuracy vs compression\", fontsize=9)\n",
    "fig.tight_layout(); fig.savefig(os.path.join(cfg.fig_dir, \"04_memory_tradeoff.png\"),\n",
    "                                bbox_inches=\"tight\", dpi=140)\n",
    "plt.show()\n",
    "\n",
    "qa_pivot = summary.pivot(index=\"k\", columns=\"policy\", values=\"auroc\")\n",
    "tol = 0.02\n",
    "print(f\"Smallest memory that stays within {tol:.2f} AUROC of the dense baseline \"\n",
    "      f\"({dense_auc:.3f} with {D_IN} numbers):\\n\")\n",
    "for p in (\"question-aware\", \"activation-only\", \"random-k\"):\n",
    "    ok = qa_pivot[qa_pivot[p] >= dense_auc - tol]\n",
    "    if len(ok):\n",
    "        ks = int(ok.index.min())\n",
    "        print(f\"  {p:16s} k = {ks:3d}  ->  {2*ks:4d} numbers  \"\n",
    "              f\"({D_IN/(2*ks):5.1f}x compression, AUROC {qa_pivot.loc[ks, p]:.3f})\")\n",
    "    else:\n",
    "        print(f\"  {p:16s} never reached it (best {qa_pivot[p].max():.3f} at k=\"\n",
    "              f\"{int(qa_pivot[p].idxmax())})\")\n",
    "\n",
    "qa_best, ao_best = qa_pivot[\"question-aware\"], qa_pivot[\"activation-only\"]\n",
    "small = [k for k in qa_pivot.index if k <= 8]\n",
    "print(\"\\nDoes question-aware routing beat question-agnostic top-k at small memory sizes?\")\n",
    "print(f\"  mean AUROC over k <= 8:  question-aware {qa_best.loc[small].mean():.3f}\"\n",
    "      f\" | activation-only {ao_best.loc[small].mean():.3f}\")\n",
    "print(\"  \" + (\"yes - text-derived relevance is buying something.\"\n",
    "              if qa_best.loc[small].mean() > ao_best.loc[small].mean() + 0.005 else\n",
    "              \"no - simply keeping the loudest features does as well or better here. Report that.\"\n",
    "              + (\"\" if REAL_TEXT_SPACE else \" (Expected: the stub encoder has no text space.)\")))"
   ]
