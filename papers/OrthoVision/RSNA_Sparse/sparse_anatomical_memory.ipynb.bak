    "# %% [2] Dependencies -------------------------------------------------------\n",
    "# Installs anything missing into the *running kernel*. Safe to re-run.\n",
    "import importlib, subprocess, sys\n",
    "\n",
    "REQUIRED = {\n",
    "    \"torch\": \"torch\",\n",
    "    \"torchvision\": \"torchvision\",\n",
    "    \"numpy\": \"numpy\",\n",
    "    \"pandas\": \"pandas\",\n",
    "    \"matplotlib\": \"matplotlib\",\n",
    "    \"sklearn\": \"scikit-learn\",\n",
    "    \"scipy\": \"scipy\",\n",
    "    \"PIL\": \"pillow\",\n",
    "}\n",
    "OPTIONAL = {           # needed only for the real BioMedCLIP encoder\n",
    "    \"open_clip\": \"open_clip_torch\",\n",
    "    \"transformers\": \"transformers\",\n",
    "}\n",
    "\n",
    "def install(pkgs):\n",
    "    \"\"\"Install into the running kernel. Handles uv-created venvs, which have no pip inside.\"\"\"\n",
    "    has_pip = importlib.util.find_spec(\"pip\") is not None\n",
    "    attempts = ([[sys.executable, \"-m\", \"pip\", \"install\", \"-q\", *pkgs]] if has_pip else []) + [\n",
    "        [\"uv\", \"pip\", \"install\", \"--python\", sys.executable, *pkgs],\n",
    "        [sys.executable, \"-m\", \"ensurepip\", \"--upgrade\"],   # last resort: bootstrap pip, then retry\n",
    "    ]\n",
    "    for cmd in attempts:\n",
    "        try:\n",
    "            subprocess.check_call(cmd)\n",
    "            if cmd[-1] == \"--upgrade\":                       # ensurepip succeeded; retry the install\n",
    "                subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", *pkgs])\n",
    "            return True\n",
    "        except (subprocess.CalledProcessError, FileNotFoundError):\n",
    "            continue\n",
    "    return False\n",
    "\n",
    "\n",
    "missing = [pkg for mod, pkg in REQUIRED.items() if importlib.util.find_spec(mod) is None]\n",
    "if missing:\n",
    "    print(\"Installing:\", missing)\n",
    "    if not install(missing):\n",
    "        raise RuntimeError(\n",
    "            f\"Could not install {missing} into {sys.executable}.\\n\"\n",
    "            f\"Install them yourself, then restart the kernel, e.g.:\\n\"\n",
    "            f\"  uv pip install --python {sys.executable} {' '.join(missing)}\")\n",
    "\n",
    "if cfg.encoder_mode in (\"auto\", \"biomedclip\"):\n",
    "    opt_missing = [pkg for mod, pkg in OPTIONAL.items() if importlib.util.find_spec(mod) is None]\n",
    "    if opt_missing:\n",
    "        print(\"Installing (BioMedCLIP):\", opt_missing)\n",
    "        if not install(opt_missing):\n",
    "            print(\"  !! install failed - this run would fall back to the STUB encoder.\")\n",
    "            print(\"  !! To get the real encoder, run this in a terminal, then restart the kernel:\")\n",
    "            print(f\"       uv pip install --python {sys.executable} {' '.join(opt_missing)}\")\n",
    "\n",
    "print(\"dependency check done\")"
   ]
  },
