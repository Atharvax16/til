   "metadata": {},
   "source": [
    "---\n",
    "## 6. Stage E — question-aware sparse memory\n",
    "\n",
    "For a question such as *\"Is there evidence of meniscal abnormality?\"* we keep only the **top-k**\n",
    "sparse features per image and throw the rest away, then answer from that memory alone.\n",
    "\n",
    "Feature relevance to a question is computed **without labels**, from the dictionary geometry:\n",
    "$r_j=\\cos\\big(W_d[j],\\,t_q\\big)$ where $t_q$ is the BioMedCLIP text embedding of the question's\n",
    "concept. The memory keeps the k features maximising $z_j\\cdot\\mathrm{ReLU}(r_j)$.\n",
    "\n",
    "Four policies are compared at each k:\n",
    "\n",
    "* **question-aware** — the policy above;\n",
    "* **activation-only** — top-k by magnitude, question-agnostic (MovieChat-style \"keep the loudest\");\n",
    "* **random-k** — chance control;\n",
    "* **dense baseline** — the full 512-d embedding, no compression.\n",
    "\n",
    "A small logistic-regression head is fit on the training split for each policy/k and evaluated on the\n",
    "patient-disjoint validation split. Compression is reported as retained numbers relative to the dense\n",
    "vector (a kept feature costs an index + a value, so 2k numbers vs. D)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "id": "cell-23",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "mean QA AUROC over 4 questions\n",
      "  dense baseline (512 numbers) : 0.930\n",
      "  full sparse code (~67 numbers): 0.918\n",
      "policy  activation-only  question-aware  random-k\n",
      "k                                                \n",
      "1                 0.870           0.828     0.500\n",
      "2                 0.884           0.863     0.503\n",
      "4                 0.905           0.889     0.507\n",
      "8                 0.908           0.897     0.518\n",
      "16                0.915           0.908     0.549\n",
      "32                0.918           0.912     0.610\n",
      "64                0.918           0.913     0.693\n"
     ]
    }
   ],
   "source": [
    "# %% [16] Question-aware memory + QA sweep ----------------------------------\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.metrics import roc_auc_score, f1_score, accuracy_score\n",
    "\n",
    "QUESTIONS = {\n",
    "    \"Is there evidence of meniscal abnormality?\": (\"lbl_meniscus_tear\", \"meniscus_tear\"),\n",
    "    \"Is there an anterior cruciate ligament tear?\": (\"lbl_acl_tear\", \"acl_tear\"),\n",
    "    \"Is there a joint effusion?\": (\"lbl_effusion\", \"effusion\"),\n",
    "    \"Is there bone marrow edema?\": (\"lbl_bone_marrow_edema\", \"bone_marrow_edema\"),\n",
    "}\n",
    "QUESTIONS = {q: v for q, v in QUESTIONS.items() if v[0] in LABEL_COLS}\n",
    "\n",
    "tr_meta = meta[is_train].reset_index(drop=True)\n",
    "rel_all = Wd_u @ T_emb.T          # (H, C) feature <-> concept relevance\n",
    "\n",
    "\n",
    "def topk_mask(Z, scores_row, k):\n",
    "    \"\"\"Keep k entries per row by `scores_row` (N,H); zero elsewhere.\"\"\"\n",
    "    k = min(k, Z.shape[1])\n",
    "    idx = np.argpartition(-scores_row, k - 1, axis=1)[:, :k]\n",
    "    out = np.zeros_like(Z)\n",
    "    np.put_along_axis(out, idx, np.take_along_axis(Z, idx, 1), 1)\n",
    "    return out\n",
    "\n",
    "\n",
    "def fit_eval(Atr, ytr, Ava, yva):\n",
    "    if len(np.unique(ytr)) < 2:\n",
    "        return dict(acc=np.nan, f1=np.nan, auroc=np.nan)\n",
    "    clf = LogisticRegression(max_iter=2000, C=1.0, class_weight=\"balanced\")\n",
    "    clf.fit(Atr, ytr)\n",
    "    p = clf.predict_proba(Ava)[:, 1]\n",
    "    return dict(acc=accuracy_score(yva, p > 0.5), f1=f1_score(yva, p > 0.5, zero_division=0),\n",
    "                auroc=roc_auc_score(yva, p) if len(np.unique(yva)) > 1 else np.nan)\n",
    "\n",
    "\n",
    "rng_r = np.random.default_rng(cfg.seed + 11)\n",
    "rand_scores_tr = rng_r.random(Ztr.shape).astype(np.float32)\n",
    "rand_scores_va = rng_r.random(Zva.shape).astype(np.float32)\n",
    "\n",
    "qa_rows = []\n",
    "for q, (lab_col, concept) in QUESTIONS.items():\n",
    "    ytr, yva = tr_meta[lab_col].values, va_meta[lab_col].values\n",
    "    ci = concept_names.index(concept)\n",
    "    r = np.maximum(rel_all[:, ci], 0)[None, :]        # (1,H) question relevance\n",
    "\n",
    "    qa_rows.append(dict(question=q, policy=\"dense baseline\", k=D_IN, numbers=D_IN,\n",
    "                        **fit_eval(Xtr_raw, ytr, Xva_raw, yva)))\n",
    "    qa_rows.append(dict(question=q, policy=\"full sparse\", k=D_HID, numbers=2 * float(m_va[\"l0\"]),\n",
    "                        **fit_eval(Ztr, ytr, Zva, yva)))\n",
    "    for k in cfg.memory_ks:\n",
    "        for policy, str_, sva in ((\"question-aware\", Ztr * r, Zva * r),\n",
    "                                  (\"activation-only\", Ztr, Zva),\n",
    "                                  (\"random-k\", rand_scores_tr, rand_scores_va)):\n",
    "            Mtr, Mva = topk_mask(Ztr, str_, k), topk_mask(Zva, sva, k)\n",
    "            qa_rows.append(dict(question=q, policy=policy, k=k, numbers=2 * k,\n",
    "                                **fit_eval(Mtr, ytr, Mva, yva)))\n",
    "\n",
    "qa = pd.DataFrame(qa_rows)\n",
    "qa.to_csv(os.path.join(cfg.report_dir, \"qa_sweep.csv\"), index=False)\n",
    "\n",
    "pol = qa[qa.policy.isin([\"question-aware\", \"activation-only\", \"random-k\"])]\n",
    "summary = pol.groupby([\"policy\", \"k\"])[[\"auroc\", \"f1\"]].mean().reset_index()\n",
    "dense_auc = qa[qa.policy == \"dense baseline\"].auroc.mean()\n",
    "sparse_auc = qa[qa.policy == \"full sparse\"].auroc.mean()\n",
    "\n",
    "print(f\"mean QA AUROC over {len(QUESTIONS)} questions\")\n",
    "print(f\"  dense baseline (512 numbers) : {dense_auc:.3f}\")\n",
    "print(f\"  full sparse code (~{2*m_va['l0']:.0f} numbers): {sparse_auc:.3f}\")\n",
    "print(summary.pivot(index=\"k\", columns=\"policy\", values=\"auroc\").round(3).to_string())"
   ]
  },
