    "# %% [18] Qualitative evidence trace ----------------------------------------\n",
    "q = list(QUESTIONS)[0]\n",
    "lab_col, concept = QUESTIONS[q]\n",
    "ci = concept_names.index(concept)\n",
    "r = np.maximum(rel_all[:, ci], 0)\n",
    "cand = np.where(va_meta[lab_col].values == 1)[0]\n",
    "i = int(cand[0]) if len(cand) else 0\n",
    "sel_idx = np.argsort(-(Zva[i] * r))[:5]\n",
    "\n",
    "print(f\"Question : {q}\")\n",
    "print(f\"Image    : {va_meta.loc[i,'image_id']}  (ground truth {lab_col} = {va_meta.loc[i,lab_col]})\")\n",
    "print(f\"Memory   : 5 of {D_HID} features retained\\n\")\n",
    "print(f\"{'feat':>6} {'activation':>11} {'q-relevance':>12}  candidate concept / best attribute\")\n",
    "for j in sel_idx:\n",
    "    la = {a: unit_lift[a][j] for a in ATTRS}\n",
    "    ba = max(la, key=la.get)\n",
    "    print(f\"F{j:<5d} {Zva[i,j]:11.3f} {r[j]:12.3f}  {concept_names[best_concept[j]]:<20s}\"\n",
    "          f\" | {ba} (lift {la[ba]:.2f})\")\n",
    "print(\"\\nThese are candidate concepts. Read them as hypotheses, not explanations:\")\n",
    "print(\"the notebook has not established that the QA head answers *because* of these features.\")\n",
    "show_feature_grid(sel_idx[:3], Zva, va_meta, n_img=6, fname=\"05_evidence_trace.png\",\n",
    "                  title=f\"Evidence retained for: {q}\")"
   ]
