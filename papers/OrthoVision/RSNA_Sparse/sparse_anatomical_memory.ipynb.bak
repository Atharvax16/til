   "source": [
    "### 5.2 Text alignment with a controlled vocabulary\n",
    "\n",
    "Encode a fixed clinical vocabulary with the **BioMedCLIP text tower** and ask, for each SAE feature,\n",
    "which concept its activation tracks. Two views of the same question:\n",
    "\n",
    "* **Activation correlation** — Pearson correlation across images between a feature's activation and\n",
    "  the image–text cosine similarity for a concept.\n",
    "* **Dictionary-direction alignment** — cosine between the feature's decoder column $W_d[j]$ (a\n",
    "  direction in the frozen embedding space) and the concept's text embedding. This one needs no\n",
    "  images and is what §6 uses to route a question to features.\n",
    "\n",
    "> ⚠️ With the stub encoder there is no shared image–text space, so this subsection's numbers are\n",
    "> plumbing only. The notebook prints a warning when that is the case."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "id": "cell-21",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Candidate feature interpretations (the word 'candidate' is load-bearing):\n",
      "\n",
      "feature  firing_rate candidate_concept   corr        dict_align    best_attribute  lift\n",
      "  F1022        0.036       t2_weighted  0.044       t2_weighted bone_marrow_edema  3.22\n",
      "   F600        0.033       t1_weighted  0.059       t2_weighted bone_marrow_edema  2.65\n",
      "   F136        0.034 bone_marrow_edema  0.150      coronal_view   [view=sagittal]  2.51\n",
      "   F234        0.032  cartilage_defect  0.147  cartilage_defect    [view=coronal]  2.59\n",
      "   F262        0.029     meniscus_tear  0.101     meniscus_tear     [protocol=T2]  2.80\n",
      "   F482        0.030  cartilage_defect  0.211  cartilage_defect bone_marrow_edema  2.65\n",
      "   F812        0.056       t2_weighted  0.039       t1_weighted bone_marrow_edema  3.50\n",
      "   F759        0.054       t2_weighted -0.077       t2_weighted bone_marrow_edema  4.35\n",
      "   F395        0.053  cartilage_defect  0.193  cartilage_defect  cartilage_defect  3.14\n",
      "    F55        0.024       t2_weighted -0.040       t2_weighted bone_marrow_edema  3.22\n",
      "   F583        0.023       t2_weighted  0.055       t2_weighted bone_marrow_edema  2.93\n",
      "   F449        0.043       t2_weighted -0.013 bone_marrow_edema      [view=axial]  2.80\n",
      "   F861        0.032          meniscus  0.096          meniscus     meniscus_tear  2.64\n",
      "   F880        0.021               pcl  0.084     sagittal_view bone_marrow_edema  2.84\n",
      "   F140        0.046       t1_weighted -0.114       t2_weighted      [view=axial]  2.80\n"
     ]
    }
   ],
   "source": [
    "# %% [15] Controlled vocabulary and text alignment --------------------------\n",
    "CONCEPTS = {\n",
    "    \"acl_tear\": \"an MRI of the knee showing a tear of the anterior cruciate ligament\",\n",
    "    \"pcl\": \"an MRI of the knee showing the posterior cruciate ligament\",\n",
    "    \"meniscus_tear\": \"an MRI of the knee showing a meniscal tear\",\n",
    "    \"meniscus\": \"an MRI of the knee showing the meniscus\",\n",
    "    \"cartilage_defect\": \"an MRI of the knee showing articular cartilage thinning and a cartilage defect\",\n",
    "    \"bone_marrow_edema\": \"an MRI of the knee showing bone marrow edema in the femur or tibia\",\n",
    "    \"effusion\": \"an MRI of the knee showing a joint effusion with fluid in the joint space\",\n",
    "    \"normal_knee\": \"an MRI of a normal knee with no abnormality\",\n",
    "    # imaging-context concepts: they let us see when a feature tracks acquisition, not anatomy\n",
    "    \"sagittal_view\": \"a sagittal plane MRI image of the knee\",\n",
    "    \"coronal_view\": \"a coronal plane MRI image of the knee\",\n",
    "    \"axial_view\": \"an axial plane MRI image of the knee\",\n",
    "    \"t1_weighted\": \"a T1 weighted MRI image\",\n",
    "    \"t2_weighted\": \"a T2 weighted fluid sensitive MRI image\",\n",
    "}\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def encode_texts(texts):\n",
    "    if ENCODER_KIND == \"biomedclip\":\n",
    "        tok = tokenizer(texts).to(DEVICE)\n",
    "        t = model.encode_text(tok).float().cpu().numpy()\n",
    "    else:\n",
    "        t = model.encode_text_strings(texts).numpy()\n",
    "    return t / (np.linalg.norm(t, axis=1, keepdims=True) + 1e-8)\n",
    "\n",
    "\n",
    "concept_names = list(CONCEPTS)\n",
    "T_emb = encode_texts([CONCEPTS[c] for c in concept_names])          # (C, D) unit norm\n",
    "\n",
    "if not REAL_TEXT_SPACE:\n",
    "    print(\"!! STUB ENCODER: image and text vectors are NOT in a shared space.\")\n",
    "    print(\"!! Everything below in 5.2 and the question-aware routing in section 6 is plumbing only.\\n\")\n",
    "\n",
    "# (i) activation <-> image-text similarity correlation\n",
    "Xva_u = Xva_raw / (np.linalg.norm(Xva_raw, axis=1, keepdims=True) + 1e-8)\n",
    "S = Xva_u @ T_emb.T                                                  # (N, C) image-text sims\n",
    "\n",
    "Zc = Zva - Zva.mean(0, keepdims=True)\n",
    "Sc = S - S.mean(0, keepdims=True)\n",
    "corr = (Zc.T @ Sc) / (np.linalg.norm(Zc, axis=0)[:, None] * np.linalg.norm(Sc, axis=0)[None, :] + 1e-8)\n",
    "\n",
    "# (ii) decoder-direction alignment (image-free)\n",
    "Wd = sae.W_dec.detach().cpu().numpy()\n",
    "Wd_u = Wd / (np.linalg.norm(Wd, axis=1, keepdims=True) + 1e-8)\n",
    "align = Wd_u @ T_emb.T                                               # (H, C)\n",
    "\n",
    "best_concept = np.argmax(corr, 1)\n",
    "best_corr = corr[np.arange(D_HID), best_concept]\n",
    "\n",
    "unit_lift = {a: prec_by_attr[\"SAE features\"][a] / max(base_rates[a], 1e-9)\n",
    "             for a in ATTRS}                                  # attr -> per-feature lift\n",
    "\n",
    "tbl = []\n",
    "for j in order[:15]:\n",
    "    lj = {a: unit_lift[a][j] for a in ATTRS}\n",
    "    top_lab = max(lj, key=lj.get)\n",
    "    tbl.append(dict(feature=f\"F{j}\", firing_rate=round(float(freq_va[j]), 3),\n",
    "                    candidate_concept=concept_names[best_concept[j]],\n",
    "                    corr=round(float(best_corr[j]), 3),\n",
    "                    dict_align=concept_names[int(np.argmax(align[j]))],\n",
    "                    best_attribute=top_lab, lift=round(float(lj[top_lab]), 2)))\n",
    "feat_table = pd.DataFrame(tbl)\n",
    "feat_table.to_csv(os.path.join(cfg.report_dir, \"candidate_features.csv\"), index=False)\n",
    "print(\"Candidate feature interpretations (the word 'candidate' is load-bearing):\\n\")\n",
    "print(feat_table.to_string(index=False))"
   ]
  },
