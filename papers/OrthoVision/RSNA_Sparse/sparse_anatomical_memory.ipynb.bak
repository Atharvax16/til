   "source": [
    "# %% [13] Selectivity: SAE features vs dense dims vs controls ---------------\n",
    "def auroc_matrix(A, y):\n",
    "    \"\"\"Two-sided AUROC of every column of A against binary y (ties handled).\"\"\"\n",
    "    y = np.asarray(y).astype(bool)\n",
    "    n1, n0 = int(y.sum()), int((~y).sum())\n",
    "    if n1 == 0 or n0 == 0:\n",
    "        return np.full(A.shape[1], np.nan)\n",
    "    R = rankdata(A, axis=0)\n",
    "    auc = (R[y].sum(0) - n1 * (n1 + 1) / 2) / (n0 * n1)\n",
    "    return np.maximum(auc, 1 - auc)\n",
    "\n",
    "\n",
    "def precision_at_k(A, y, k):\n",
    "    \"\"\"Fraction of each column's top-k images carrying attribute y.\n",
    "\n",
    "    Columns are scored in both signs (max), so signed dense dimensions are treated fairly.\n",
    "    \"\"\"\n",
    "    y = np.asarray(y).astype(bool)\n",
    "    if y.all() or not y.any():\n",
    "        return np.full(A.shape[1], np.nan)\n",
    "    k = min(k, A.shape[0] - 1)\n",
    "    out = []\n",
    "    for sign in (1, -1):\n",
    "        idx = np.argpartition(-sign * A, k, axis=0)[:k]\n",
    "        out.append(y[idx].mean(0))\n",
    "    return np.maximum(out[0], out[1])\n",
    "\n",
    "\n",
    "def lift_at_k(A, y, k):\n",
    "    \"\"\"precision@k divided by the base rate. Capped at 1/base_rate, so it saturates for\n",
    "    common attributes - always read it next to the precision itself.\"\"\"\n",
    "    base = np.mean(np.asarray(y).astype(bool))\n",
    "    return precision_at_k(A, y, k) / max(base, 1e-9)\n",
    "\n",
    "\n",
    "def auroc_ceiling(freq, prevalence):\n",
    "    \"\"\"Highest AUROC attainable by a feature that fires on `freq` of images (see markdown).\"\"\"\n",
    "    return 0.5 + 0.5 * np.minimum(1.0, freq / max(prevalence, 1e-9))\n",
    "\n",
    "\n",
    "# --- control 1: random ReLU features, same width, L0 matched to the SAE\n",
    "rng_c = np.random.default_rng(cfg.seed + 7)\n",
    "Rproj = rng_c.normal(0, 1 / math.sqrt(D_IN), (D_IN, D_HID)).astype(np.float32)\n",
    "Zrand_tr, Zrand_va = np.maximum(Xtr @ Rproj, 0), np.maximum(Xva @ Rproj, 0)\n",
    "k_match = max(1, int(round(m_va[\"l0\"])))\n",
    "def sparsify(Z, k):\n",
    "    out = np.zeros_like(Z)\n",
    "    idx = np.argpartition(-Z, k, axis=1)[:, :k]\n",
    "    np.put_along_axis(out, idx, np.take_along_axis(Z, idx, 1), 1)\n",
    "    return out\n",
    "Zrand_tr, Zrand_va = sparsify(Zrand_tr, k_match), sparsify(Zrand_va, k_match)\n",
    "\n",
    "ATTRS = {}\n",
    "for c in LABEL_COLS:\n",
    "    ATTRS[c.replace(\"lbl_\", \"\")] = va_meta[c].values.astype(int)\n",
    "for c in META_COLS:                       # nuisance attributes as one-vs-rest\n",
    "    for v in sorted(va_meta[c].dropna().unique()):\n",
    "        if str(v) != \"unknown\":\n",
    "            ATTRS[f\"[{c.replace('meta_','')}={v}]\"] = (va_meta[c] == v).astype(int).values\n",
    "\n",
    "BANKS = {\"SAE features\": Zva, \"Dense dims\": Xva_raw, \"Random ReLU (matched)\": Zrand_va}\n",
    "\n",
    "# coverage matched to the median SAE feature: every unit may claim the same number of images\n",
    "n_val = Zva.shape[0]\n",
    "med_freq = float(np.median(freq_va[freq_va > 0])) if (freq_va > 0).any() else 0.03\n",
    "K_P = int(cfg.precision_at_k) or int(np.clip(round(med_freq * n_val), 16, n_val // 4))\n",
    "print(f\"matched coverage: k = {K_P} images ({100*K_P/n_val:.1f}% of the validation split; \"\n",
    "      f\"median SAE firing rate {med_freq:.3f})\\n\")\n",
    "\n",
    "LIFT_ENRICHED = 2.0\n",
    "rows, best_prec_per_unit, prec_by_attr, n_enriched = [], {}, {}, {}\n",
    "for bank, A in BANKS.items():\n",
    "    precs, aucs, enr = {}, {}, []\n",
    "    for a, y in ATTRS.items():\n",
    "        precs[a] = precision_at_k(A, y, K_P)\n",
    "        aucs[a] = auroc_matrix(A, y)\n",
    "        base = float(np.mean(y))\n",
    "        enr.append(precs[a] > LIFT_ENRICHED * base)\n",
    "        rows.append(dict(bank=bank, attribute=a, n_units=A.shape[1], base_rate=base,\n",
    "                         max_precision=float(np.nanmax(precs[a])),\n",
    "                         max_lift=float(np.nanmax(precs[a]) / max(base, 1e-9)),\n",
    "                         mean_top10_precision=float(np.sort(precs[a][~np.isnan(precs[a])])[-10:].mean()),\n",
    "                         max_auroc=float(np.nanmax(aucs[a])),\n",
    "                         frac_units_prec_gt_2x=float(np.nanmean(precs[a] > 2 * base))))\n",
    "    prec_by_attr[bank] = precs\n",
    "    best_prec_per_unit[bank] = np.nanmax(np.stack(list(precs.values())), 0)\n",
    "    n_enriched[bank] = np.stack(enr).sum(0)          # attributes each unit is enriched for\n",
    "\n",
    "sel = pd.DataFrame(rows)\n",
    "\n",
    "# --- control 2: shuffled-label null (what does a bank of this size reach by chance?)\n",
    "null_rows = []\n",
    "for bank, A in BANKS.items():\n",
    "    for a in list(ATTRS)[:3]:\n",
    "        y = ATTRS[a].copy()\n",
    "        for r in range(5):\n",
    "            np.random.default_rng(r).shuffle(y)\n",
    "            null_rows.append(dict(bank=bank,\n",
    "                                  max_precision=float(np.nanmax(precision_at_k(A, y, K_P))),\n",
    "                                  max_auroc=float(np.nanmax(auroc_matrix(A, y)))))\n",
    "null_df = pd.DataFrame(null_rows).groupby(\"bank\")[[\"max_precision\", \"max_auroc\"]].mean()\n",
    "null = null_df[\"max_auroc\"]\n",
    "\n",
    "BANK_ORDER = [c for c in [\"SAE features\", \"Dense dims\", \"Random ReLU (matched)\"]\n",
    "              if c in set(sel.bank)]\n",
    "piv = sel.pivot_table(index=\"attribute\", columns=\"bank\", values=\"max_precision\")[BANK_ORDER]\n",
    "piv_auc = sel.pivot_table(index=\"attribute\", columns=\"bank\", values=\"max_auroc\")[BANK_ORDER]\n",
    "base_rates = sel.groupby(\"attribute\").base_rate.first()\n",
    "\n",
    "print(f\"PURITY: best precision @ top-{K_P} images per attribute\\n\"\n",
    "      f\"(read against 'base rate' = chance; 1.00 = every top image carries the attribute)\\n\")\n",
    "print(piv.assign(base_rate=base_rates).round(3).to_string())\n",
    "print(\"\\nShuffled-label null (mean best precision / best AUROC over 5 permutations):\")\n",
    "print(null_df.round(3).to_string())\n",
    "\n",
    "print(f\"\\nMONOSEMANTICITY: attributes a single unit is enriched for (lift >= {LIFT_ENRICHED:.0f}),\"\n",
    "      \" lower = more selective\\n\")\n",
    "mono = pd.DataFrame({b: pd.Series(v).describe()[[\"mean\", \"max\"]] for b, v in n_enriched.items()}).T\n",
    "mono.columns = [\"mean_attrs_per_unit\", \"max\"]\n",
    "mono[\"frac_enriched_for_any\"] = [float((n_enriched[b] > 0).mean()) for b in mono.index]\n",
    "mono[\"frac_single_attribute\"] = [float((n_enriched[b] == 1).mean()) for b in mono.index]\n",
    "# Conditional on being informative at all. Without this a bank of uninformative units would\n",
    "# \"win\" monosemanticity simply by being enriched for nothing.\n",
    "mono[\"attrs_given_enriched\"] = [float(n_enriched[b][n_enriched[b] > 0].mean())\n",
    "                                if (n_enriched[b] > 0).any() else np.nan for b in mono.index]\n",
    "print(mono.round(3).to_string())\n",
    "print(\"  read 'attrs_given_enriched' as the headline: among units that respond to anything,\")\n",
    "print(\"  how many different attributes does one unit respond to?\")\n",
    "\n",
    "print(\"\\nSECONDARY: best AUROC per attribute - remember the sparsity ceiling\")\n",
    "print(piv_auc.round(3).to_string())\n",
    "med_f = float(np.median(freq_va[freq_va > 0]))\n",
    "print(f\"\\n  median SAE firing rate {med_f:.3f}; at that firing rate the AUROC of a *perfectly clean*\")\n",
    "print(\"  feature is capped at: \" + \", \".join(\n",
    "    f\"{a}={auroc_ceiling(med_f, ATTRS[a].mean()):.2f}\"\n",
    "    for a in list(ATTRS)[:4]))"
   ]
  },
