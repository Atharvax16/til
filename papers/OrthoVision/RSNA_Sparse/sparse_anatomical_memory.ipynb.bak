    "# %% [1] Configuration -------------------------------------------------------\n",
    "import os\n",
    "from dataclasses import dataclass, asdict, field\n",
    "from typing import Tuple\n",
    "\n",
    "# Environment overrides (used for quick smoke tests):\n",
    "#   SAM_SMOKE=1        -> tiny run (few images, few epochs)\n",
    "#   SAM_ENCODER=stub   -> skip BioMedCLIP download, use a frozen random-projection encoder\n",
    "#   SAM_JEPA=1         -> also run the optional JEPA-style appendix in section 8\n",
    "SMOKE = os.environ.get(\"SAM_SMOKE\", \"0\") == \"1\"\n",
    "\n",
    "\n",
    "@dataclass\n",
    "class Config:\n",
    "    seed: int = 0\n",
    "    root: str = \".\"\n",
    "\n",
    "    # ---- data -------------------------------------------------------------\n",
    "    # If a real knee-MRI dataset is present here it is used instead of synthetic data.\n",
    "    # Supported layout: MRNet-style  <real_data_dir>/train/{axial,coronal,sagittal}/*.npy\n",
    "    #                                <real_data_dir>/train-{abnormal,acl,meniscus}.csv\n",
    "    real_data_dir: str = \"data/raw\"\n",
    "    n_patients: int = 1000         # synthetic corpus size\n",
    "    images_per_patient: int = 6    # -> 6000 images, inside the outline's 1k-10k range\n",
    "    image_size: int = 224\n",
    "    val_frac: float = 0.30         # patient-level split, no leakage\n",
    "\n",
    "    # ---- Stage A: frozen encoder -----------------------------------------\n",
    "    encoder_mode: str = \"auto\"     # auto | biomedclip | stub\n",
    "    encoder_name: str = \"hf-hub:microsoft/BiomedCLIP-PubMedBERT_256-vit_base_patch16_224\"\n",
    "    encode_batch: int = 32\n",
    "\n",
    "    # ---- Stage B: sparse autoencoder --------------------------------------\n",
    "    sae_mode: str = \"l1\"           # \"l1\" (outline default) or \"topk\"\n",
    "    expansion: int = 2             # latent width = expansion * d_in   (outline: 2x-8x)\n",
    "    target_l0: int = 32            # desired active features per image\n",
    "    l1_coeff: float = 0.1          # initial sparsity penalty (adapted if adapt_lambda)\n",
    "    adapt_lambda: bool = True      # dual ascent on lambda to hold L0 at target_l0\n",
    "    lambda_lr: float = 0.05\n",
    "    topk: int = 32                 # used when sae_mode == \"topk\"\n",
    "    lr: float = 1e-3\n",
    "    epochs: int = 300\n",
    "    batch_size: int = 256\n",
    "    warmup_frac: float = 0.05      # linear warm-up of the sparsity penalty\n",
    "    resample_every: int = 15       # epochs between dead-feature resampling\n",
    "    resample_until: float = 0.85   # stop resampling after this fraction of training\n",
    "    resample_max_frac: float = 0.06  # revive at most this fraction of the dictionary per event\n",
    "    resample_scale: float = 0.05   # peak activation given to a revived feature\n",
    "    precision_at_k: int = 0        # k for precision@k; 0 = match the median SAE firing count\n",
    "\n",
    "    # ---- Stage E: memory / QA ---------------------------------------------\n",
    "    memory_ks: Tuple[int, ...] = (1, 2, 4, 8, 16, 32, 64)\n",
    "\n",
    "    # ---- Appendix ----------------------------------------------------------\n",
    "    run_jepa_appendix: bool = False\n",
    "\n",
    "    # ---- derived paths -----------------------------------------------------\n",
    "    @property\n",
    "    def data_dir(self):   return os.path.join(self.root, \"data\")\n",
    "    @property\n",
    "    def img_dir(self):    return os.path.join(self.data_dir, \"images\")\n",
    "    @property\n",
    "    def cache_dir(self):  return os.path.join(self.root, \"artifacts\")\n",
    "    @property\n",
    "    def fig_dir(self):    return os.path.join(self.root, \"reports\", \"figures\")\n",
    "    @property\n",
    "    def report_dir(self): return os.path.join(self.root, \"reports\")\n",
    "\n",
    "\n",
    "cfg = Config()\n",
    "\n",
    "if SMOKE:\n",
    "    cfg.n_patients = 60\n",
    "    cfg.images_per_patient = 4\n",
    "    cfg.epochs = 60\n",
    "    cfg.batch_size = 64\n",
    "    cfg.resample_every = 20\n",
    "if os.environ.get(\"SAM_ENCODER\"):\n",
    "    cfg.encoder_mode = os.environ[\"SAM_ENCODER\"]\n",
    "if os.environ.get(\"SAM_JEPA\") == \"1\":\n",
    "    cfg.run_jepa_appendix = True\n",
    "\n",
    "for d in (cfg.data_dir, cfg.img_dir, cfg.cache_dir, cfg.fig_dir, cfg.report_dir):\n",
    "    os.makedirs(d, exist_ok=True)\n",
    "\n",
    "print(\"Configuration\")\n",
    "for k, v in asdict(cfg).items():\n",
    "    print(f\"  {k:20s} {v}\")\n",
    "print(f\"  smoke-test mode      {SMOKE}\")"
   ]
  },
