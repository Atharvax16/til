   "source": [
    "# %% [10] Train the SAE ------------------------------------------------------\n",
    "D_HID = cfg.expansion * D_IN\n",
    "seed_all(cfg.seed)\n",
    "\n",
    "sae = SparseAutoencoder(D_IN, D_HID, cfg.sae_mode, cfg.topk).to(DEVICE)\n",
    "opt = torch.optim.Adam(sae.parameters(), lr=cfg.lr, betas=(0.9, 0.999))\n",
    "\n",
    "Xtr_t = torch.from_numpy(Xtr).to(DEVICE)\n",
    "Xva_t = torch.from_numpy(Xva).to(DEVICE)\n",
    "n_tr = Xtr_t.shape[0]\n",
    "steps_per_epoch = max(1, n_tr // cfg.batch_size)\n",
    "total_steps = steps_per_epoch * cfg.epochs\n",
    "warm = max(1, int(cfg.warmup_frac * total_steps))\n",
    "\n",
    "fire_count = torch.zeros(D_HID, device=DEVICE)   # firings since last resample check\n",
    "history, step = [], 0\n",
    "lam_base = cfg.l1_coeff                          # adapted by dual ascent (see markdown above)\n",
    "t0 = time.time()\n",
    "\n",
    "for epoch in range(cfg.epochs):\n",
    "    perm = torch.randperm(n_tr, device=DEVICE)\n",
    "    l0_epoch, lam = 0.0, 0.0\n",
    "    for b in range(steps_per_epoch):\n",
    "        xb = Xtr_t[perm[b * cfg.batch_size:(b + 1) * cfg.batch_size]]\n",
    "        xh, z = sae(xb)\n",
    "        recon = ((xb - xh) ** 2).sum(-1).mean()\n",
    "        lam = lam_base * min(1.0, (step + 1) / warm) if cfg.sae_mode == \"l1\" else 0.0\n",
    "        loss = recon + lam * z.abs().sum(-1).mean()\n",
    "\n",
    "        opt.zero_grad(set_to_none=True)\n",
    "        loss.backward()\n",
    "        sae.project_decoder_grad()\n",
    "        opt.step()\n",
    "        sae.normalise_decoder()\n",
    "\n",
    "        with torch.no_grad():\n",
    "            l0_epoch += (z > 0).float().sum(-1).mean().item()\n",
    "            fire_count += (z > 0).float().sum(0)\n",
    "        step += 1\n",
    "\n",
    "    # ---- dual ascent on the sparsity multiplier ----------------------------\n",
    "    if cfg.sae_mode == \"l1\" and cfg.adapt_lambda and step > warm:\n",
    "        l0_now = max(l0_epoch / steps_per_epoch, 1e-6)\n",
    "        # log-ratio error, clipped: fast enough far from target, gentle near it (avoids overshoot\n",
    "        # into a dead-feature collapse, which a linear error term reliably caused here)\n",
    "        gap = float(np.clip(math.log(l0_now / max(cfg.target_l0, 1)), -1.0, 1.0))\n",
    "        lam_base = float(np.clip(lam_base * math.exp(cfg.lambda_lr * gap), 1e-6, 1e4))\n",
    "\n",
    "    # ---- dead-feature resampling ------------------------------------------\n",
    "    if ((epoch + 1) % cfg.resample_every == 0 and epoch < cfg.resample_until * cfg.epochs):\n",
    "        dead = (fire_count == 0).nonzero().flatten()\n",
    "        if len(dead) > 0:\n",
    "            with torch.no_grad():\n",
    "                # Revive a bounded number per event. Reviving every dead feature at once puts\n",
    "                # hundreds of *mutually correlated* data directions back into the dictionary\n",
    "                # simultaneously, which spikes the reconstruction loss for many epochs.\n",
    "                n_rev = min(len(dead), max(1, int(cfg.resample_max_frac * D_HID)))\n",
    "                xh_all, _ = sae(Xtr_t)\n",
    "                err = ((Xtr_t - xh_all) ** 2).sum(-1)\n",
    "                p = (err / err.sum()).clamp_min(1e-12)\n",
    "                idx = torch.multinomial(p, n_rev, replacement=True)\n",
    "                v = Xtr_t[idx] - sae.b_dec\n",
    "                v = v / v.norm(dim=-1, keepdim=True).clamp_min(1e-8)\n",
    "                d = dead[:n_rev]\n",
    "                # Scale each revived encoder row so its strongest activation over the training set\n",
    "                # is resample_scale. Revived features should come back quiet and grow only if the\n",
    "                # gradient says they are useful.\n",
    "                proj = (Xtr_t - sae.b_dec) @ v.T                     # (N, n_rev)\n",
    "                hi = proj.clamp_min(0).max(dim=0).values.clamp_min(1e-3)\n",
    "                sae.W_dec.data[d] = v\n",
    "                sae.W_enc.data[:, d] = (v * (cfg.resample_scale / hi[:, None])).T\n",
    "                sae.b_enc.data[d] = 0.0\n",
    "                for pname in (\"W_enc\", \"b_enc\", \"W_dec\"):\n",
    "                    st = opt.state.get(getattr(sae, pname), None)\n",
    "                    if st:\n",
    "                        if pname == \"W_enc\":\n",
    "                            st[\"exp_avg\"][:, d] = 0; st[\"exp_avg_sq\"][:, d] = 0\n",
    "                        else:\n",
    "                            st[\"exp_avg\"][d] = 0; st[\"exp_avg_sq\"][d] = 0\n",
    "        fire_count.zero_()\n",
    "\n",
    "    if (epoch + 1) % max(1, cfg.epochs // 20) == 0 or epoch == 0:\n",
    "        sae.eval()\n",
    "        m_tr, m_va = sae_metrics(sae, Xtr_t), sae_metrics(sae, Xva_t)\n",
    "        sae.train()\n",
    "        history.append(dict(epoch=epoch + 1, lam=lam, **{f\"tr_{k}\": v for k, v in m_tr.items()},\n",
    "                            **{f\"va_{k}\": v for k, v in m_va.items()}))\n",
    "        print(f\"ep {epoch+1:4d} | lam {lam_base:7.3f} | train mse {m_tr['mse']:7.3f} \"\n",
    "              f\"EV {m_tr['explained_var']:5.3f} | val mse {m_va['mse']:7.3f} \"\n",
    "              f\"EV {m_va['explained_var']:5.3f} cos {m_va['cosine']:5.3f} \"\n",
    "              f\"L0 {m_va['l0']:6.1f} dead {m_va['dead_frac']*100:5.1f}%\")\n",
    "\n",
    "sae.eval()\n",
    "hist = pd.DataFrame(history)\n",
    "train_time = time.time() - t0\n",
    "print(f\"\\ntrained {total_steps} steps in {train_time:.1f}s on {DEVICE}\")\n",
    "torch.save({\"state_dict\": sae.state_dict(), \"cfg\": asdict(cfg), \"mu\": MU, \"scale\": SCALE},\n",
    "           os.path.join(cfg.cache_dir, \"sae.pt\"))"
   ]
  },
