   ],
   "source": [
    "# %% [14] Selectivity figure -------------------------------------------------\n",
    "path_attrs = [c.replace(\"lbl_\", \"\") for c in LABEL_COLS]\n",
    "nuis_attrs = [a for a in ATTRS if a.startswith(\"[\")]\n",
    "\n",
    "fig, ax = plt.subplots(1, 3, figsize=(15, 3.8))\n",
    "\n",
    "# (a) best precision@k per attribute, bank vs bank, against the base rate\n",
    "w, xs = 0.26, np.arange(len(piv.index))\n",
    "for i, b in enumerate(piv.columns):\n",
    "    ax[0].bar(xs + (i - 1) * w, piv[b].values, w, label=b)\n",
    "ax[0].plot(xs, base_rates.loc[piv.index].values, \"k_\", ms=12, mew=1.6, label=\"base rate (chance)\")\n",
    "ax[0].set_xticks(xs); ax[0].set_xticklabels(piv.index, rotation=60, ha=\"right\", fontsize=6.5)\n",
    "ax[0].set_ylabel(f\"best precision @ top-{K_P}\"); ax[0].set_ylim(0, 1.05); ax[0].legend(fontsize=6.5)\n",
    "ax[0].set_title(\"(a) best unit per attribute\", fontsize=9)\n",
    "\n",
    "# (b) monosemanticity: how many attributes does one unit answer to?\n",
    "nmax = int(max(v.max() for v in n_enriched.values()))\n",
    "bins = np.arange(-0.5, nmax + 1.5)\n",
    "for i, (b, v) in enumerate(n_enriched.items()):\n",
    "    ax[1].hist(v, bins=bins, histtype=\"step\", lw=1.6, density=True, label=b)\n",
    "ax[1].set_xlabel(f\"attributes a unit is enriched for (lift >= {LIFT_ENRICHED:.0f})\")\n",
    "ax[1].set_ylabel(\"fraction of units\")\n",
    "ax[1].legend(fontsize=6.5); ax[1].set_title(\"(b) monosemanticity - lower is better\", fontsize=9)\n",
    "\n",
    "# (c) pathology vs nuisance: what do the cleanest SAE features encode?\n",
    "#     lift is used here (not precision) so attributes of different prevalence are comparable\n",
    "lift_path = np.nanmax(np.stack([prec_by_attr[\"SAE features\"][a] / max(base_rates[a], 1e-9)\n",
    "                                for a in path_attrs]), 0)\n",
    "lift_nuis = (np.nanmax(np.stack([prec_by_attr[\"SAE features\"][a] / max(base_rates[a], 1e-9)\n",
    "                                 for a in nuis_attrs]), 0)\n",
    "             if nuis_attrs else np.zeros_like(lift_path))\n",
    "ax[2].scatter(lift_nuis[usable], lift_path[usable], s=7, alpha=0.4)\n",
    "lim = float(np.nanmax([lift_path[usable].max() if usable.any() else 1,\n",
    "                       lift_nuis[usable].max() if usable.any() else 1])) * 1.05\n",
    "ax[2].plot([0, lim], [0, lim], \"k--\", lw=0.8)\n",
    "ax[2].axhline(1, lw=0.6, color=\"gray\"); ax[2].axvline(1, lw=0.6, color=\"gray\")\n",
    "ax[2].set_xlabel(\"best lift vs acquisition (view/protocol/scanner)\")\n",
    "ax[2].set_ylabel(\"best lift vs pathology\")\n",
    "ax[2].set_title(\"(c) each dot = one SAE feature\", fontsize=9)\n",
    "\n",
    "fig.tight_layout(); fig.savefig(os.path.join(cfg.fig_dir, \"03_selectivity.png\"),\n",
    "                                bbox_inches=\"tight\", dpi=140)\n",
    "plt.show()\n",
    "\n",
    "# Clean vs confounded is judged by comparing each feature against ITSELF (pathology lift vs\n",
    "# acquisition lift, i.e. which side of the diagonal in panel (c)), not against absolute cut-offs.\n",
    "# Both lifts are maxima over several attributes, so an absolute threshold would mostly measure how\n",
    "# many attributes went into each maximum.\n",
    "LIFT_HI, MARGIN = 2.0, 1.25\n",
    "n_clean = int(((lift_path > LIFT_HI) & (lift_path > MARGIN * lift_nuis) & usable).sum())\n",
    "n_conf = int(((lift_nuis >= lift_path) & usable).sum())\n",
    "n_usable = int(usable.sum())\n",
    "sae_best, dense_best = piv[\"SAE features\"], piv[\"Dense dims\"]\n",
    "rand_best = piv[\"Random ReLU (matched)\"]\n",
    "path_rows = [c.replace(\"lbl_\", \"\") for c in LABEL_COLS]\n",
    "TIE = 0.02\n",
    "diff = sae_best.loc[path_rows] - dense_best.loc[path_rows]\n",
    "wins, ties = int((diff > TIE).sum()), int((diff.abs() <= TIE).sum())\n",
    "\n",
    "print(f\"Of {n_usable} usable SAE features (panel c):\")\n",
    "print(f\"  better explained by pathology than by acquisition, lift > {LIFT_HI}: {n_clean}\"\n",
    "      f\"  ({100*n_clean/max(n_usable,1):.0f}%)\")\n",
    "print(f\"  at least as enriched for acquisition as for pathology         : {n_conf}\"\n",
    "      f\"  ({100*n_conf/max(n_usable,1):.0f}%)\")\n",
    "print(\"  the second group is the 'candidate anatomical concept' that is really a view, a pulse\")\n",
    "print(\"  sequence or a scanner - exactly what the outline warns about.\\n\")\n",
    "print(\"VERDICT on the main research question\")\n",
    "print(f\"\\n  (1) purity - pathology attributes, best SAE feature vs best dense dim (precision@{K_P}):\")\n",
    "print(f\"      SAE better {wins} | tied (within {TIE}) {ties} | dense better \"\n",
    "      f\"{len(path_rows) - wins - ties}   of {len(path_rows)}\")\n",
    "print(f\"      mean best precision:  SAE {sae_best.loc[path_rows].mean():.3f}\"\n",
    "      f\" | dense {dense_best.loc[path_rows].mean():.3f}\"\n",
    "      f\" | random {rand_best.loc[path_rows].mean():.3f}\"\n",
    "      f\" | chance {base_rates.loc[path_rows].mean():.3f}\")\n",
    "d_mean = sae_best.loc[path_rows].mean() - dense_best.loc[path_rows].mean()\n",
    "verdict_purity = (\"SAE ahead\" if d_mean > TIE else \"dense ahead\" if d_mean < -TIE else \"tied\")\n",
    "print(f\"      -> {verdict_purity}\"\n",
    "      + (\"  (both banks are near the ceiling, so purity does not decide this)\"\n",
    "         if min(sae_best.loc[path_rows].mean(), dense_best.loc[path_rows].mean()) > 0.9 else \"\"))\n",
    "\n",
    "m_sae, m_dense = mono.loc[\"SAE features\"], mono.loc[\"Dense dims\"]\n",
    "m_rand = mono.loc[\"Random ReLU (matched)\"]\n",
    "print(f\"\\n  (2) monosemanticity - attributes per informative unit (lower = more selective):\")\n",
    "print(f\"      SAE {m_sae.attrs_given_enriched:.2f} | dense {m_dense.attrs_given_enriched:.2f}\"\n",
    "      f\" | random {m_rand.attrs_given_enriched:.2f}\")\n",
    "print(f\"      units enriched for exactly one attribute:\"\n",
    "      f\"  SAE {100*m_sae.frac_single_attribute:.1f}%\"\n",
    "      f\" | dense {100*m_dense.frac_single_attribute:.1f}%\"\n",
    "      f\" | random {100*m_rand.frac_single_attribute:.1f}%\")\n",
    "verdict_mono = (\"SAE ahead\" if m_sae.attrs_given_enriched < m_dense.attrs_given_enriched - 0.05\n",
    "                else \"dense ahead\" if m_sae.attrs_given_enriched > m_dense.attrs_given_enriched + 0.05\n",
    "                else \"tied\")\n",
    "print(f\"      -> {verdict_mono}\")\n",
    "\n",
    "print(f\"\\n  ANSWER: purity {verdict_purity}, monosemanticity {verdict_mono}.\")\n",
    "if verdict_mono == \"SAE ahead\" and verdict_purity == \"dense ahead\":\n",
    "    print(\"  Split verdict, and it is the informative one. Dense dimensions are the better\")\n",
    "    print(\"  *detectors* - one dimension separates a finding more cleanly. SAE features are the\")\n",
    "    print(\"  more *selective* units - each responds to far fewer distinct attributes. The research\")\n",
    "    print(\"  question asks about selective association, so this supports the SAE on the axis it\")\n",
    "    print(\"  asked about while contradicting any claim that the SAE detects pathology better.\")\n",
    "    print(\"  Both halves belong in the write-up; reporting only one would misrepresent the run.\")\n",
    "elif verdict_mono == \"SAE ahead\":\n",
    "    print(\"  The sparse code buys selectivity: comparable or better purity, each feature\")\n",
    "    print(\"  responding to fewer attributes. That is what the research question asks about.\")\n",
    "elif verdict_mono == \"dense ahead\":\n",
    "    print(\"  This does not support the hypothesis on either axis. Report it as a negative result\")\n",
    "    print(\"  rather than tuning until it flips; a null result here is honest and publishable.\")\n",
    "else:\n",
    "    print(\"  Inconclusive on this data. Say so, and state what would settle it (real data, an\")\n",
    "    print(\"  encoder that separates these findings, expert-reviewed feature labels).\")\n",
    "print(\"\\n  Caveat: the SAE bank has more units than the dense bank, so it gets more chances at a\")\n",
    "print(\"  high score. The shuffled-label null and the width-matched random control price that in.\")"
   ]
  },
