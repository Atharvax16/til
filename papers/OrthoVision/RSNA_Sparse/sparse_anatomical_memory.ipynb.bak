    "---\n",
    "## 4. Stage C — feature inspection\n",
    "\n",
    "For each sparse feature, rank images by activation and display the top-activating set. The outline\n",
    "is right that this is more persuasive than a loss curve — and it is also the step where you can see\n",
    "a feature that \"looks like pathology\" actually tracking a **view** or a **pulse sequence**.\n",
    "\n",
    "Features are ranked for display by a simple *selectivity score*: how concentrated a feature's\n",
    "activation mass is on its top images, times how often it fires (excluding features that fire almost\n",
    "always or almost never, which are uninformative)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "cell-16",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "usable features (0.5% < firing rate < 50%): 1007 / 1024\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1188x1089 with 48 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# %% [12] Rank and display candidate features -------------------------------\n",
    "va_meta = meta[~is_train].reset_index(drop=True)\n",
    "\n",
    "\n",
    "def feature_scores(Z):\n",
    "    f = (Z > 0).mean(0)\n",
    "    mass = np.zeros(Z.shape[1])\n",
    "    top = min(16, Z.shape[0])\n",
    "    part = np.partition(Z, -top, axis=0)[-top:]\n",
    "    denom = Z.sum(0) + 1e-9\n",
    "    mass = part.sum(0) / denom                  # activation concentration on top images\n",
    "    usable = (f > 0.005) & (f < 0.5)\n",
    "    return f, mass, usable\n",
    "\n",
    "\n",
    "freq_va, mass_va, usable = feature_scores(Zva)\n",
    "score = mass_va * np.sqrt(freq_va) * usable\n",
    "order = np.argsort(-score)\n",
    "top_feats = order[:6]\n",
    "print(f\"usable features (0.5% < firing rate < 50%): {usable.sum()} / {D_HID}\")\n",
    "\n",
    "\n",
    "def show_feature_grid(feats, Z, meta_df, n_img=8, fname=None, title=None):\n",
    "    rows = len(feats)\n",
    "    fig, axes = plt.subplots(rows, n_img, figsize=(1.35 * n_img, 1.65 * rows))\n",
    "    axes = np.atleast_2d(axes)\n",
    "    for r, j in enumerate(feats):\n",
    "        idx = np.argsort(-Z[:, j])[:n_img]\n",
    "        for c, i in enumerate(idx):\n",
    "            ax = axes[r, c]\n",
    "            ax.imshow(Image.open(meta_df.loc[i, \"path\"]), cmap=\"gray\"); ax.axis(\"off\")\n",
    "            pos = [k.replace(\"lbl_\", \"\") for k in LABEL_COLS\n",
    "                   if meta_df.loc[i, k] == 1 and k != \"lbl_normal_knee\"]\n",
    "            ax.set_title(f\"{Z[i, j]:.2f}\\n{','.join(pos)[:22] if pos else 'normal'}\", fontsize=5.5)\n",
    "        axes[r, 0].text(-0.35, 0.5, f\"F{j}\", transform=axes[r, 0].transAxes,\n",
    "                        rotation=90, va=\"center\", fontsize=8, fontweight=\"bold\")\n",
    "    if title:\n",
    "        fig.suptitle(title, y=1.005)\n",
    "    fig.tight_layout()\n",
    "    if fname:\n",
    "        fig.savefig(os.path.join(cfg.fig_dir, fname), bbox_inches=\"tight\", dpi=140)\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "show_feature_grid(top_feats, Zva, va_meta, fname=\"02_top_activating.png\",\n",
    "                  title=\"Top-activating validation images for the 6 most selective candidate features\")"
   ]
  },
