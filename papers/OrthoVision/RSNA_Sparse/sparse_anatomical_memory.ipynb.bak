   "source": [
    "# %% [11] Training diagnostics ----------------------------------------------\n",
    "@torch.no_grad()\n",
    "def encode_all(sae, x_np, bs=1024):\n",
    "    out = []\n",
    "    for i in range(0, len(x_np), bs):\n",
    "        out.append(sae.encode(torch.from_numpy(x_np[i:i + bs]).to(DEVICE)).cpu().numpy())\n",
    "    return np.concatenate(out)\n",
    "\n",
    "\n",
    "Ztr, Zva = encode_all(sae, Xtr), encode_all(sae, Xva)\n",
    "m_va, m_tr = sae_metrics(sae, Xva_t), sae_metrics(sae, Xtr_t)\n",
    "\n",
    "# cosine similarity in the ORIGINAL embedding space (un-normalised)\n",
    "with torch.no_grad():\n",
    "    xh_va = sae(Xva_t)[0].cpu().numpy() * SCALE + MU\n",
    "cos_orig = float(np.mean(np.sum(xh_va * Xva_raw, 1) /\n",
    "                         (np.linalg.norm(xh_va, axis=1) * np.linalg.norm(Xva_raw, axis=1) + 1e-8)))\n",
    "\n",
    "freq = (Zva > 0).mean(0)\n",
    "alive = freq > 0\n",
    "fig, ax = plt.subplots(1, 4, figsize=(15, 3.2))\n",
    "ax[0].plot(hist.epoch, hist.tr_mse, label=\"train\"); ax[0].plot(hist.epoch, hist.va_mse, label=\"val\")\n",
    "ax[0].set_title(\"reconstruction MSE\"); ax[0].set_xlabel(\"epoch\"); ax[0].legend()\n",
    "ax[1].plot(hist.epoch, hist.va_l0, color=\"C2\", label=\"L0\")\n",
    "ax[1].axhline(cfg.target_l0, ls=\"--\", c=\"k\", lw=0.8, label=\"target\")\n",
    "ax1b = ax[1].twinx(); ax1b.plot(hist.epoch, hist.lam, color=\"C5\", lw=0.9); ax1b.grid(False)\n",
    "ax1b.set_ylabel(\"lambda\", color=\"C5\")\n",
    "ax[1].set_title(\"L0 (active features / image)\"); ax[1].set_xlabel(\"epoch\"); ax[1].legend(fontsize=6)\n",
    "ax[2].plot(hist.epoch, hist.va_dead_frac * 100, color=\"C3\")\n",
    "ax[2].set_title(\"dead features (%)\"); ax[2].set_xlabel(\"epoch\")\n",
    "ax[3].hist(np.log10(freq[alive] + 1e-6), bins=40, color=\"C4\")\n",
    "ax[3].set_title(\"log10 firing frequency (alive)\"); ax[3].set_xlabel(\"log10 freq\")\n",
    "fig.tight_layout(); fig.savefig(os.path.join(cfg.fig_dir, \"01_sae_training.png\"),\n",
    "                                bbox_inches=\"tight\", dpi=140)\n",
    "plt.show()\n",
    "\n",
    "print(f\"VAL   reconstruction MSE (normalised space) : {m_va['mse']:.4f}   (train {m_tr['mse']:.4f})\")\n",
    "print(f\"VAL   explained variance                    : {m_va['explained_var']:.4f}   (train {m_tr['explained_var']:.4f})\")\n",
    "print(f\"VAL   cosine(x, x_hat) in original space    : {cos_orig:.4f}\")\n",
    "print(f\"VAL   mean L0 (active features per image)   : {m_va['l0']:.1f} / {D_HID}   (target {cfg.target_l0})\")\n",
    "print(f\"VAL   dead features                         : {m_va['dead_frac']*100:.1f}%\")\n",
    "print(f\"      dense baseline active dims            : {(np.abs(Xva_raw) > 1e-6).sum(1).mean():.1f} / {D_IN}\")\n",
    "gap = m_va[\"mse\"] / max(m_tr[\"mse\"], 1e-9)\n",
    "va_curve = hist.va_mse.values\n",
    "degraded = float(va_curve[-1]) > 1.05 * float(va_curve.min())\n",
    "print(f\"      val/train MSE ratio                   : {gap:.2f}\")\n",
    "print(\"      generalisation                        : \"\n",
    "      + (\"val MSE rose above its minimum - the dictionary is overfitting; stop earlier, add data,\"\n",
    "         \" or raise sparsity\" if degraded else\n",
    "         \"val MSE still at its minimum at the last epoch - the train/val gap is a fit-quality gap,\"\n",
    "         \" not degradation\"))"
