    "# %% [3] Imports, device, determinism --------------------------------------\n",
    "import json, math, time, hashlib, warnings\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "import matplotlib.pyplot as plt\n",
    "from PIL import Image\n",
    "from scipy import ndimage\n",
    "from scipy.stats import rankdata\n",
    "\n",
    "warnings.filterwarnings(\"ignore\", category=UserWarning)\n",
    "plt.rcParams.update({\"figure.dpi\": 110, \"font.size\": 9, \"axes.grid\": True,\n",
    "                     \"grid.alpha\": 0.25, \"axes.spines.top\": False, \"axes.spines.right\": False})\n",
    "\n",
    "def pick_device():\n",
    "    if torch.backends.mps.is_available():\n",
    "        return torch.device(\"mps\")\n",
    "    if torch.cuda.is_available():\n",
    "        return torch.device(\"cuda\")\n",
    "    return torch.device(\"cpu\")\n",
    "\n",
    "DEVICE = pick_device()\n",
    "\n",
    "def seed_all(s):\n",
    "    np.random.seed(s); torch.manual_seed(s)\n",
    "    if torch.cuda.is_available(): torch.cuda.manual_seed_all(s)\n",
    "\n",
    "seed_all(cfg.seed)\n",
    "print(f\"torch {torch.__version__} | device: {DEVICE}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-04",
   "metadata": {},
   "source": [
    "---\n",
    "## 1. Data\n",
    "\n",
    "The outline says: use only data you are allowed to access; if the full RSNA knee MRI data is\n",
    "constrained, start from a public de-identified subset **or a synthetic control set**, and keep a\n",
    "**patient-level** train/eval split.\n",
    "\n",
    "This notebook does both:\n",
    "\n",
    "* **Real data path** — if an MRNet-style directory is found at `cfg.real_data_dir`, it takes\n",
    "  slices from the `.npy` volumes and the provided `abnormal / acl / meniscus` labels.\n",
    "* **Synthetic path (default)** — renders a controlled knee-MRI-like corpus. Each *patient* gets\n",
    "  pathology labels; each *image* gets nuisance factors (view, pulse-sequence contrast, scanner\n",
    "  noise/bias field). Fluid-sensitive findings (effusion, bone-marrow edema) are deliberately made\n",
    "  **more visible on T2/PD than T1**, and pathologies are **correlated** (an ACL tear raises the\n",
    "  probability of effusion), because both properties are true of real knee MRI and both are traps\n",
    "  for naive interpretability claims.\n",
    "\n",
    "Ground truth for the synthetic corpus is written to `data/metadata.csv`:\n",
    "`lbl_*` columns are the pathology targets, `meta_*` columns are the nuisance factors."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "cell-05",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "renderer ready\n"
     ]
    }
   ],
   "source": [
    "# %% [4] Synthetic knee-MRI-like renderer -----------------------------------\n",
    "# Deliberately simple, deterministic geometry. The point is *known* generative factors,\n",
    "# not radiological realism.\n",
    "\n",
    "LABEL_COLS_SYNTH = [\"lbl_acl_tear\", \"lbl_meniscus_tear\", \"lbl_cartilage_defect\",\n",
    "                    \"lbl_bone_marrow_edema\", \"lbl_effusion\", \"lbl_normal_knee\"]\n",
    "VIEWS = [\"sagittal\", \"coronal\", \"axial\"]\n",
    "PROTOCOLS = [\"T1\", \"T2\", \"PD\"]\n",
    "\n",
    "# tissue intensities per pulse sequence (fluid bright on T2, dark on T1)\n",
    "TISSUE = {\n",
    "    \"T1\": dict(fluid=0.28, marrow=0.78, muscle=0.34, cartilage=0.50, ligament=0.12, cortex=0.04),\n",
    "    \"T2\": dict(fluid=0.96, marrow=0.48, muscle=0.26, cartilage=0.58, ligament=0.10, cortex=0.04),\n",
    "    \"PD\": dict(fluid=0.72, marrow=0.66, muscle=0.30, cartilage=0.62, ligament=0.11, cortex=0.04),\n",
    "}\n",
    "\n",
    "\n",
    "def _grid(size):\n",
    "    y, x = np.mgrid[0:size, 0:size].astype(np.float32) / (size - 1)\n",
    "    return x, y\n",
    "\n",
    "\n",
    "def _ellipse(x, y, cx, cy, rx, ry, ang=0.0):\n",
    "    ca, sa = math.cos(ang), math.sin(ang)\n",
    "    xr = (x - cx) * ca + (y - cy) * sa\n",
    "    yr = -(x - cx) * sa + (y - cy) * ca\n",
    "    return (xr / rx) ** 2 + (yr / ry) ** 2 <= 1.0\n",
    "\n",
    "\n",
    "def _blob(x, y, cx, cy, r):\n",
    "    return np.exp(-(((x - cx) ** 2 + (y - cy) ** 2) / (2 * r ** 2)))\n",
    "\n",
    "\n",
    "def _band(x, y, p0, p1, half_w):\n",
    "    # distance to segment p0->p1\n",
    "    px, py = p1[0] - p0[0], p1[1] - p0[1]\n",
    "    denom = px * px + py * py + 1e-8\n",
    "    t = np.clip(((x - p0[0]) * px + (y - p0[1]) * py) / denom, 0, 1)\n",
    "    dx, dy = x - (p0[0] + t * px), y - (p0[1] + t * py)\n",
    "    return np.sqrt(dx * dx + dy * dy) <= half_w, t\n",
    "\n",
    "\n",
    "def render_knee(rng, lab, view, protocol, scanner, size=224):\n",
    "    \"\"\"Return a float32 [0,1] image of shape (size, size).\"\"\"\n",
    "    x, y = _grid(size)\n",
    "    T = TISSUE[protocol]\n",
    "    img = np.full((size, size), T[\"muscle\"] * 0.55, np.float32)\n",
    "\n",
    "    jitter = lambda s=0.012: float(rng.normal(0, s))\n",
    "    # ---- soft-tissue envelope\n",
    "    env = _ellipse(x, y, 0.50 + jitter(), 0.50 + jitter(), 0.40, 0.46)\n",
    "    img[env] = T[\"muscle\"]\n",
    "\n",
    "    if view in (\"sagittal\", \"coronal\"):\n",
    "        if view == \"sagittal\":\n",
    "            fem = _ellipse(x, y, 0.46 + jitter(), 0.30 + jitter(), 0.26, 0.20)\n",
    "            tib = _ellipse(x, y, 0.50 + jitter(), 0.79 + jitter(), 0.25, 0.18)\n",
    "            pat = _ellipse(x, y, 0.16 + jitter(), 0.42 + jitter(), 0.07, 0.10)\n",
    "            joint_y = 0.545\n",
    "            men_c = [(0.34, joint_y), (0.66, joint_y)]\n",
    "            acl_p0, acl_p1 = (0.38, 0.63), (0.60, 0.36)\n",
    "        else:  # coronal\n",
    "            fem = _ellipse(x, y, 0.50 + jitter(), 0.28 + jitter(), 0.32, 0.19)\n",
    "            tib = _ellipse(x, y, 0.50 + jitter(), 0.80 + jitter(), 0.30, 0.17)\n",
    "            pat = np.zeros_like(fem, bool)\n",
    "            joint_y = 0.545\n",
    "            men_c = [(0.30, joint_y), (0.70, joint_y)]\n",
    "            acl_p0, acl_p1 = (0.47, 0.62), (0.53, 0.38)\n",
    "\n",
    "        for m in (fem, tib, pat):\n",
    "            img[m] = T[\"marrow\"]\n",
    "            rim = ndimage.binary_dilation(m, iterations=2) & ~ndimage.binary_erosion(m, iterations=2)\n",
    "            img[rim] = T[\"cortex\"]\n",
    "\n",
    "        # ---- articular cartilage (thins with a cartilage defect)\n",
    "        thick = 0.020 if not lab[\"lbl_cartilage_defect\"] else 0.007\n",
    "        cart = (np.abs(y - (joint_y - 0.030)) < thick) | (np.abs(y - (joint_y + 0.030)) < thick)\n",
    "        cart &= (np.abs(x - 0.5) < 0.26)\n",
    "        img[cart] = T[\"cartilage\"]\n",
    "\n",
    "        # ---- menisci: dark wedges at the joint line\n",
    "        for (cx, cy) in men_c:\n",
    "            wedge = _ellipse(x, y, cx, cy, 0.055, 0.018)\n",
    "            img[wedge] = T[\"ligament\"] + 0.05\n",
    "            if lab[\"lbl_meniscus_tear\"] and rng.random() < 0.85:\n",
    "                tear, _ = _band(x, y, (cx - 0.045, cy - 0.010), (cx + 0.045, cy + 0.010), 0.0045)\n",
    "                img[tear & wedge] = T[\"fluid\"]\n",
    "\n",
    "        # ---- ACL: dark band; tear = discontinuity filled with fluid signal\n",
    "        acl, t = _band(x, y, acl_p0, acl_p1, 0.016)\n",
    "        img[acl] = T[\"ligament\"]\n",
    "        if lab[\"lbl_acl_tear\"]:\n",
    "            gap = acl & (np.abs(t - float(rng.uniform(0.35, 0.65))) < 0.16)\n",
    "            img[gap] = T[\"fluid\"] * 0.9 + 0.05\n",
    "\n",
    "        # ---- joint effusion: suprapatellar / joint-space fluid\n",
    "        if lab[\"lbl_effusion\"]:\n",
    "            sev = float(rng.uniform(0.5, 1.0))\n",
    "            pocket = _ellipse(x, y, 0.30 + jitter(0.03), 0.20 + jitter(0.03),\n",
    "                              0.10 * sev + 0.05, 0.05 * sev + 0.03)\n",
    "            rim_j = (np.abs(y - joint_y) < 0.012) & (np.abs(x - 0.5) < 0.30)\n",
    "            img[pocket | rim_j] = T[\"fluid\"]\n",
    "\n",
    "        # ---- bone marrow edema: diffuse signal change inside bone\n",
    "        if lab[\"lbl_bone_marrow_edema\"]:\n",
    "            cx, cy = (0.50 + jitter(0.06), 0.36) if rng.random() < 0.5 else (0.50 + jitter(0.06), 0.72)\n",
    "            g = _blob(x, y, cx, cy, 0.075)\n",
    "            inside = (fem | tib).astype(np.float32)\n",
    "            target = T[\"fluid\"] * 0.75 + T[\"marrow\"] * 0.25\n",
    "            img = img * (1 - 0.85 * g * inside) + target * (0.85 * g * inside)\n",
    "\n",
    "    else:  # axial view: patellofemoral cross-section, no ACL / meniscus visible\n",
    "        cond_l = _ellipse(x, y, 0.36 + jitter(), 0.62 + jitter(), 0.16, 0.20)\n",
    "        cond_r = _ellipse(x, y, 0.64 + jitter(), 0.62 + jitter(), 0.16, 0.20)\n",
    "        pat = _ellipse(x, y, 0.50 + jitter(), 0.24 + jitter(), 0.15, 0.09)\n",
    "        for m in (cond_l, cond_r, pat):\n",
    "            img[m] = T[\"marrow\"]\n",
    "            rim = ndimage.binary_dilation(m, iterations=2) & ~ndimage.binary_erosion(m, iterations=2)\n",
    "            img[rim] = T[\"cortex\"]\n",
    "        thick = 0.018 if not lab[\"lbl_cartilage_defect\"] else 0.006\n",
    "        cart = (np.abs(y - 0.40) < thick) & (np.abs(x - 0.5) < 0.22)\n",
    "        img[cart] = T[\"cartilage\"]\n",
    "        if lab[\"lbl_effusion\"]:\n",
    "            img[_ellipse(x, y, 0.50, 0.34, 0.20, 0.03)] = T[\"fluid\"]\n",
    "        if lab[\"lbl_bone_marrow_edema\"]:\n",
    "            g = _blob(x, y, 0.36 + jitter(0.05), 0.62, 0.07)\n",
    "            inside = (cond_l | cond_r).astype(np.float32)\n",
    "            img = img * (1 - 0.85 * g * inside) + (T[\"fluid\"] * 0.7) * (0.85 * g * inside)\n",
    "\n",
    "    # ---- acquisition nuisance: blur, bias field, gain, noise (scanner dependent)\n",
    "    sig = 1.0 if scanner == \"A\" else 1.6\n",
    "    img = ndimage.gaussian_filter(img, sigma=sig)\n",
    "    bx, by = rng.uniform(-1, 1), rng.uniform(-1, 1)\n",
    "    bias = 1.0 + 0.10 * (bx * (x - 0.5) + by * (y - 0.5))\n",
    "    gain = 1.0 + (0.03 if scanner == \"A\" else -0.05) + float(rng.normal(0, 0.03))\n",
    "    noise_sd = 0.020 if scanner == \"A\" else 0.038\n",
    "    img = img * bias * gain + rng.normal(0, noise_sd, img.shape)\n",
    "    return np.clip(img, 0, 1).astype(np.float32)\n",
    "\n",
    "\n",
    "def sample_patient_labels(rng):\n",
    "    acl = int(rng.random() < 0.18)\n",
    "    men = int(rng.random() < 0.28)\n",
    "    cart = int(rng.random() < 0.22)\n",
    "    bme = int(rng.random() < min(0.95, 0.12 + 0.35 * acl + 0.10 * cart))\n",
    "    eff = int(rng.random() < min(0.95, 0.10 + 0.50 * acl + 0.25 * bme))\n",
    "    lab = dict(lbl_acl_tear=acl, lbl_meniscus_tear=men, lbl_cartilage_defect=cart,\n",
    "               lbl_bone_marrow_edema=bme, lbl_effusion=eff)\n",
    "    lab[\"lbl_normal_knee\"] = int(sum(lab.values()) == 0)\n",
    "    return lab\n",
    "\n",
    "\n",
    "print(\"renderer ready\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "cell-06",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "reusing cached dataset (synthetic control corpus) - 6000 images\n",
      "\n",
      "source            : synthetic control corpus\n",
      "images            : 6000  (1000 patients)\n",
      "train / val images: 4200 / 1800\n",
      "patient overlap   : 0 (must be 0)\n",
      "\n",
      "label prevalence (image level):\n",
      "lbl_acl_tear             0.158\n",
      "lbl_meniscus_tear        0.256\n",
      "lbl_cartilage_defect     0.223\n",
      "lbl_bone_marrow_edema    0.190\n",
      "lbl_effusion             0.197\n",
      "lbl_normal_knee          0.394\n"
     ]
    }
   ],
   "source": [
    "# %% [5] Build (or discover) the dataset ------------------------------------\n",
    "def discover_real_dataset(root):\n",
    "    \"\"\"MRNet-style layout check. Returns a metadata DataFrame or None.\"\"\"\n",
    "    root = Path(root)\n",
    "    if not root.exists():\n",
    "        return None\n",
    "    planes = [p for p in (\"sagittal\", \"coronal\", \"axial\") if (root / \"train\" / p).is_dir()]\n",
    "    if not planes:\n",
    "        return None\n",
    "    lab = {}\n",
    "    for name in (\"abnormal\", \"acl\", \"meniscus\"):\n",
    "        f = root / f\"train-{name}.csv\"\n",
    "        if f.exists():\n",
    "            d = pd.read_csv(f, header=None, names=[\"case\", name], dtype={\"case\": str})\n",
    "            lab[name] = dict(zip(d[\"case\"].str.zfill(4), d[name]))\n",
    "    rows = []\n",
    "    for plane in planes:\n",
    "        for vol in sorted((root / \"train\" / plane).glob(\"*.npy\")):\n",
    "            case = vol.stem.zfill(4)\n",
    "            rows.append(dict(case=case, plane=plane, path=str(vol)))\n",
    "    if not rows:\n",
    "        return None\n",
    "    df = pd.DataFrame(rows)\n",
    "    for name, m in lab.items():\n",
    "        df[f\"lbl_{name}\"] = df[\"case\"].map(m).fillna(0).astype(int)\n",
    "    return df\n",
    "\n",
    "\n",
    "def materialise_real(df_vol, cfg):\n",
    "    \"\"\"Take 3 slices around the middle of each volume, save as PNG, build metadata.\"\"\"\n",
    "    rows = []\n",
    "    for i, r in df_vol.iterrows():\n",
    "        vol = np.load(r[\"path\"])\n",
    "        mid = vol.shape[0] // 2\n",
    "        for off in (-3, 0, 3):\n",
    "            s = int(np.clip(mid + off, 0, vol.shape[0] - 1))\n",
    "            arr = vol[s].astype(np.float32)\n",
    "            arr = (arr - arr.min()) / (arr.ptp() + 1e-6)\n",
    "            im = Image.fromarray((arr * 255).astype(np.uint8)).resize(\n",
    "                (cfg.image_size, cfg.image_size), Image.BILINEAR)\n",
    "            fn = f\"{r['case']}_{r['plane']}_{s}.png\"\n",
    "            im.save(os.path.join(cfg.img_dir, fn))\n",
    "            row = dict(image_id=fn, path=os.path.join(cfg.img_dir, fn),\n",
    "                       meta_patient=r[\"case\"], meta_view=r[\"plane\"],\n",
    "                       meta_protocol=\"unknown\", meta_scanner=\"unknown\")\n",
    "            for c in df_vol.columns:\n",
    "                if c.startswith(\"lbl_\"):\n",
    "                    row[c] = int(r[c])\n",
    "            rows.append(row)\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "def build_synthetic(cfg):\n",
    "    rows = []\n",
    "    for p in range(cfg.n_patients):\n",
    "        rng = np.random.default_rng(cfg.seed * 100003 + p)\n",
    "        lab = sample_patient_labels(rng)\n",
    "        scanner = \"A\" if rng.random() < 0.55 else \"B\"\n",
    "        for j in range(cfg.images_per_patient):\n",
    "            view = VIEWS[int(rng.integers(0, 3))]\n",
    "            protocol = PROTOCOLS[int(rng.integers(0, 3))]\n",
    "            img = render_knee(rng, lab, view, protocol, scanner, cfg.image_size)\n",
    "            fn = f\"p{p:04d}_s{j}.png\"\n",
    "            Image.fromarray((img * 255).astype(np.uint8)).save(os.path.join(cfg.img_dir, fn))\n",
    "            rows.append(dict(image_id=fn, path=os.path.join(cfg.img_dir, fn),\n",
    "                             meta_patient=f\"p{p:04d}\", meta_view=view,\n",
    "                             meta_protocol=protocol, meta_scanner=scanner, **lab))\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "META_PATH = os.path.join(cfg.data_dir, \"metadata.csv\")\n",
    "sig = hashlib.md5(json.dumps(\n",
    "    dict(n=cfg.n_patients, k=cfg.images_per_patient, s=cfg.image_size, seed=cfg.seed)\n",
    ").encode()).hexdigest()[:8]\n",
    "SIG_PATH = os.path.join(cfg.data_dir, f\".build_{sig}\")\n",
    "\n",
    "if os.path.exists(META_PATH) and os.path.exists(SIG_PATH):\n",
    "    meta = pd.read_csv(META_PATH)\n",
    "    DATA_SOURCE = json.load(open(SIG_PATH))[\"source\"]\n",
    "    print(f\"reusing cached dataset ({DATA_SOURCE}) - {len(meta)} images\")\n",
    "else:\n",
    "    t0 = time.time()\n",
    "    real = discover_real_dataset(os.path.join(cfg.root, cfg.real_data_dir))\n",
    "    if real is not None:\n",
    "        print(f\"real knee-MRI dataset found: {len(real)} volumes -> extracting slices\")\n",
    "        meta = materialise_real(real, cfg); DATA_SOURCE = \"real (MRNet-style)\"\n",
    "    else:\n",
    "        print(\"no real dataset found -> rendering the synthetic control corpus\")\n",
    "        meta = build_synthetic(cfg); DATA_SOURCE = \"synthetic control corpus\"\n",
    "    # patient-level split (no leakage)\n",
    "    pats = sorted(meta[\"meta_patient\"].unique())\n",
    "    rs = np.random.default_rng(cfg.seed).permutation(len(pats))\n",
    "    n_val = max(1, int(round(cfg.val_frac * len(pats))))\n",
    "    val_p = {pats[i] for i in rs[:n_val]}\n",
    "    meta[\"split\"] = np.where(meta[\"meta_patient\"].isin(val_p), \"val\", \"train\")\n",
    "    meta.to_csv(META_PATH, index=False)\n",
    "    json.dump({\"source\": DATA_SOURCE}, open(SIG_PATH, \"w\"))\n",
    "    print(f\"built {len(meta)} images in {time.time()-t0:.1f}s\")\n",
    "\n",
    "LABEL_COLS = [c for c in meta.columns if c.startswith(\"lbl_\")]\n",
    "META_COLS = [c for c in meta.columns if c.startswith(\"meta_\") and c != \"meta_patient\"]\n",
    "\n",
    "print(f\"\\nsource            : {DATA_SOURCE}\")\n",
    "print(f\"images            : {len(meta)}  ({meta['meta_patient'].nunique()} patients)\")\n",
    "print(f\"train / val images: {(meta.split=='train').sum()} / {(meta.split=='val').sum()}\")\n",
    "print(f\"patient overlap   : {len(set(meta[meta.split=='train'].meta_patient) & set(meta[meta.split=='val'].meta_patient))} (must be 0)\")\n",
    "print(\"\\nlabel prevalence (image level):\")\n",
    "print(meta[LABEL_COLS].mean().round(3).to_string())"
   ]
  },
