    "---\n",
    "## 2. Stage A — frozen BioMedCLIP embeddings\n",
    "\n",
    "Load the **frozen** BioMedCLIP image encoder\n",
    "(`microsoft/BiomedCLIP-PubMedBERT_256-vit_base_patch16_224`, pretrained on PMC-15M), extract one\n",
    "pooled embedding per image, and cache to disk so every later experiment is cheap. Nothing in the\n",
    "encoder is trained — the only trainable module in this project is the sparse autoencoder.\n",
    "\n",
    "**Fallback.** If `open_clip` / the model download is unavailable, the notebook substitutes a\n",
    "*frozen random-projection encoder* so the pipeline still runs end-to-end offline. This is clearly\n",
    "flagged everywhere it matters: with the stub encoder the **text-alignment results in §5.2 and the\n",
    "question-aware routing in §6 are meaningless** (there is no shared image–text space), while the\n",
    "reconstruction, sparsity and label-selectivity results remain valid statements about *that* encoder."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "cell-09",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "Warning: You are sending unauthenticated requests to the HF Hub. Please set a HF_TOKEN to enable higher rate limits and faster downloads.\n",
      "WARNING:huggingface_hub.utils._http:Warning: You are sending unauthenticated requests to the HF Hub. Please set a HF_TOKEN to enable higher rate limits and faster downloads.\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "BioMedCLIP loaded in 3.6s\n",
      "encoder = biomedclip | embedding dim = 512 | shared image-text space = True\n"
     ]
    }
   ],
   "source": [
    "# %% [7] Load the frozen encoder -------------------------------------------\n",
    "class StubEncoder(nn.Module):\n",
    "    \"\"\"Frozen random-projection stand-in used when BioMedCLIP is unavailable.\n",
    "\n",
    "    Deterministic: fixed-seed random patch filters + linear projection. It produces\n",
    "    structure-sensitive 512-d embeddings so the pipeline is testable offline, but it shares\n",
    "    NO space with any text encoder.\n",
    "    \"\"\"\n",
    "    embed_dim = 512\n",
    "\n",
    "    def __init__(self, seed=0):\n",
    "        super().__init__()\n",
    "        g = torch.Generator().manual_seed(seed)\n",
    "        self.conv = nn.Conv2d(3, 64, 16, 16, bias=False)\n",
    "        self.proj = nn.Linear(64 * 14 * 14, self.embed_dim, bias=False)\n",
    "        with torch.no_grad():\n",
    "            self.conv.weight.copy_(torch.randn(self.conv.weight.shape, generator=g) * 0.05)\n",
    "            self.proj.weight.copy_(torch.randn(self.proj.weight.shape, generator=g) * (1 / 64))\n",
    "        for p in self.parameters():\n",
    "            p.requires_grad_(False)\n",
    "        self._txt = torch.Generator().manual_seed(seed + 1)\n",
    "\n",
    "    def encode_image(self, px):\n",
    "        h = F.relu(self.conv(px)).flatten(1)\n",
    "        return F.layer_norm(self.proj(h), (self.embed_dim,))\n",
    "\n",
    "    def encode_text_strings(self, texts):\n",
    "        # hashed bag-of-words -> random vectors. Not aligned with images: for plumbing only.\n",
    "        out = []\n",
    "        for t in texts:\n",
    "            v = torch.zeros(self.embed_dim)\n",
    "            for w in t.lower().split():\n",
    "                g = torch.Generator().manual_seed(int(hashlib.md5(w.encode()).hexdigest()[:8], 16))\n",
    "                v += torch.randn(self.embed_dim, generator=g)\n",
    "            out.append(v / (v.norm() + 1e-8))\n",
    "        return torch.stack(out)\n",
    "\n",
    "\n",
    "def stub_preprocess(size):\n",
    "    from torchvision import transforms as T\n",
    "    return T.Compose([T.Resize((size, size)), T.ToTensor(),\n",
    "                      T.Normalize([0.5] * 3, [0.5] * 3)])\n",
    "\n",
    "\n",
    "ENCODER_KIND, tokenizer = \"stub\", None\n",
    "model = None\n",
    "\n",
    "if cfg.encoder_mode in (\"auto\", \"biomedclip\"):\n",
    "    try:\n",
    "        import open_clip\n",
    "        t0 = time.time()\n",
    "        model, preprocess = open_clip.create_model_from_pretrained(cfg.encoder_name)\n",
    "        tokenizer = open_clip.get_tokenizer(cfg.encoder_name)\n",
    "        model = model.to(DEVICE).eval()\n",
    "        for p in model.parameters():\n",
    "            p.requires_grad_(False)\n",
    "        ENCODER_KIND = \"biomedclip\"\n",
    "        print(f\"BioMedCLIP loaded in {time.time()-t0:.1f}s\")\n",
    "    except Exception as e:\n",
    "        if cfg.encoder_mode == \"biomedclip\":\n",
    "            raise\n",
    "        print(f\"!! could not load BioMedCLIP ({type(e).__name__}: {e})\")\n",
    "        print(\"!! falling back to the stub encoder - see the warning in section 2\")\n",
    "\n",
    "if ENCODER_KIND == \"stub\":\n",
    "    model = StubEncoder(cfg.seed).to(DEVICE).eval()\n",
    "    preprocess = stub_preprocess(cfg.image_size)\n",
    "\n",
    "REAL_TEXT_SPACE = (ENCODER_KIND == \"biomedclip\")\n",
    "D_IN = getattr(getattr(model, \"visual\", None), \"output_dim\", None) or 512\n",
    "print(f\"encoder = {ENCODER_KIND} | embedding dim = {D_IN} | shared image-text space = {REAL_TEXT_SPACE}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "cell-10",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "loaded cached embeddings (6000, 512)\n",
      "train (4200, 512) | val (1800, 512) | scale 1.0655\n",
      "dense embedding stats: mean|x| = 2.5525, active dims per image (|x|>1e-6) = 512.0 / 512\n"
     ]
    }
   ],
   "source": [
    "# %% [8] Extract and cache image embeddings ---------------------------------\n",
    "EMB_PATH = os.path.join(cfg.cache_dir, f\"emb_{ENCODER_KIND}_{sig}.npz\")\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def encode_images(paths, bs):\n",
    "    out = []\n",
    "    for i in range(0, len(paths), bs):\n",
    "        batch = torch.stack([preprocess(Image.open(p).convert(\"RGB\")) for p in paths[i:i + bs]])\n",
    "        z = model.encode_image(batch.to(DEVICE)).float().cpu()\n",
    "        out.append(z)\n",
    "        if (i // bs) % 10 == 0:\n",
    "            print(f\"  {min(i+bs, len(paths))}/{len(paths)}\", end=\"\\r\")\n",
    "    return torch.cat(out).numpy()\n",
    "\n",
    "\n",
    "if os.path.exists(EMB_PATH):\n",
    "    X = np.load(EMB_PATH)[\"X\"]\n",
    "    print(f\"loaded cached embeddings {X.shape}\")\n",
    "else:\n",
    "    t0 = time.time()\n",
    "    X = encode_images(meta[\"path\"].tolist(), cfg.encode_batch)\n",
    "    np.savez_compressed(EMB_PATH, X=X)\n",
    "    print(f\"encoded {X.shape[0]} images in {time.time()-t0:.1f}s -> {X.shape}\")\n",
    "\n",
    "D_IN = X.shape[1]\n",
    "is_train = (meta[\"split\"] == \"train\").values\n",
    "Xtr_raw, Xva_raw = X[is_train], X[~is_train]\n",
    "\n",
    "# Normalisation fitted on TRAIN only: centre, then scale so E[||x||] = sqrt(d).\n",
    "MU = Xtr_raw.mean(0, keepdims=True)\n",
    "SCALE = float(np.linalg.norm(Xtr_raw - MU, axis=1).mean() / math.sqrt(D_IN))\n",
    "norm = lambda a: (a - MU) / SCALE\n",
    "\n",
    "Xtr, Xva = norm(Xtr_raw).astype(np.float32), norm(Xva_raw).astype(np.float32)\n",
    "print(f\"train {Xtr.shape} | val {Xva.shape} | scale {SCALE:.4f}\")\n",
    "print(f\"dense embedding stats: mean|x| = {np.abs(Xtr_raw).mean():.4f}, \"\n",
    "      f\"active dims per image (|x|>1e-6) = {(np.abs(Xtr_raw) > 1e-6).sum(1).mean():.1f} / {D_IN}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-11",
   "metadata": {},
   "source": [
    "---\n",
    "## 3. Stage B — sparse autoencoder\n",
    "\n",
    "The model from the outline:\n",
    "\n",
    "$$z=\\mathrm{ReLU}\\big(W_e (x-b_d)+b_e\\big),\\qquad \\hat{x}=W_d z + b_d,\\qquad\n",
    "\\mathcal{L}=\\lVert x-\\hat{x}\\rVert_2^2+\\lambda\\lVert z\\rVert_1$$\n",
    "\n",
    "Three standard stabilisers are included, because the outline explicitly asks for a fix if feature\n",
    "collapse occurs:\n",
    "\n",
    "1. **Unit-norm decoder columns**, re-normalised after every step, with the gradient component\n",
    "   parallel to each column removed first — otherwise the network can cheat the L1 penalty by\n",
    "   shrinking $z$ and growing $W_d$.\n",
    "2. **Sparsity warm-up** over the first 5 % of steps.\n",
    "3. **Dead-feature resampling**: features that have not fired for a long window are re-initialised\n",
    "   onto directions of poorly-reconstructed examples.\n",
    "\n",
    "**One deliberate deviation from the outline.** A fixed $\\lambda$ does not transfer between encoders:\n",
    "the reconstruction term is a sum over $D$ dimensions whose scale depends entirely on the embedding\n",
    "you happen to be reading, so the same $\\lambda$ that gives $L_0\\approx30$ on one encoder gives\n",
    "$L_0\\approx1000$ on another (this notebook's first run reproduced exactly that failure). So\n",
    "$\\lambda$ is **adapted during training by dual ascent** to hold the mean $L_0$ at\n",
    "`cfg.target_l0` — $\\lambda \\leftarrow \\lambda\\exp\\big(\\eta(L_0/L_0^{\\*}-1)\\big)$. The objective is\n",
    "unchanged; only the multiplier is scheduled, and it makes sparsity comparable across encoders and\n",
    "runs. Set `cfg.adapt_lambda = False` for the plain fixed-$\\lambda$ version, or\n",
    "`cfg.sae_mode = \"topk\"` for a Top-K SAE (exact L0, no shrinkage bias)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "cell-12",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "SAE defined\n"
     ]
    }
   ],
   "source": [
    "# %% [9] Sparse autoencoder --------------------------------------------------\n",
    "class SparseAutoencoder(nn.Module):\n",
    "    def __init__(self, d_in, d_hidden, mode=\"l1\", k=32):\n",
    "        super().__init__()\n",
    "        self.d_in, self.d_hidden, self.mode, self.k = d_in, d_hidden, mode, k\n",
    "        W = torch.randn(d_hidden, d_in)\n",
    "        W = W / W.norm(dim=1, keepdim=True)          # unit-norm decoder rows (= dictionary atoms)\n",
    "        self.W_dec = nn.Parameter(W)                  # (H, D)\n",
    "        self.W_enc = nn.Parameter(W.clone().T.contiguous())  # (D, H)\n",
    "        self.b_enc = nn.Parameter(torch.zeros(d_hidden))\n",
    "        self.b_dec = nn.Parameter(torch.zeros(d_in))\n",
    "\n",
    "    def encode(self, x):\n",
    "        z = F.relu((x - self.b_dec) @ self.W_enc + self.b_enc)\n",
    "        if self.mode == \"topk\":\n",
    "            k = min(self.k, self.d_hidden)\n",
    "            thresh = z.topk(k, dim=-1).values[:, -1:]\n",
    "            z = z * (z >= thresh)\n",
    "        return z\n",
    "\n",
    "    def decode(self, z):\n",
    "        return z @ self.W_dec + self.b_dec\n",
    "\n",
    "    def forward(self, x):\n",
    "        z = self.encode(x)\n",
    "        return self.decode(z), z\n",
    "\n",
    "    @torch.no_grad()\n",
    "    def normalise_decoder(self):\n",
    "        self.W_dec.data /= self.W_dec.data.norm(dim=1, keepdim=True).clamp_min(1e-8)\n",
    "\n",
    "    @torch.no_grad()\n",
    "    def project_decoder_grad(self):\n",
    "        if self.W_dec.grad is None:\n",
    "            return\n",
    "        w = self.W_dec.data\n",
    "        par = (self.W_dec.grad * w).sum(-1, keepdim=True) * w\n",
    "        self.W_dec.grad -= par\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def sae_metrics(sae, x):\n",
    "    \"\"\"Reconstruction / sparsity metrics, in the normalised embedding space.\"\"\"\n",
    "    xh, z = sae(x)\n",
    "    mse = ((x - xh) ** 2).sum(-1).mean().item()\n",
    "    ev = (1 - (x - xh).var(0).sum() / x.var(0).sum().clamp_min(1e-8)).item()\n",
    "    cos = F.cosine_similarity(x, xh, dim=-1).mean().item()\n",
    "    l0 = (z > 0).float().sum(-1).mean().item()\n",
    "    fired = (z > 0).any(0)\n",
    "    return dict(mse=mse, explained_var=ev, cosine=cos, l0=l0,\n",
    "                dead_frac=1 - fired.float().mean().item())\n",
    "\n",
    "\n",
    "print(\"SAE defined\")"
   ]
  },
